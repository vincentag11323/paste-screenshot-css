# ── LLM provider: Cent AI (https://cent-ai.dev) ─────────────────────────────
# Anthropic-Messages-shape gateway: POST {LLM_BASE_URL}/messages, header x-api-key.
LLM_API_FORMAT=messages
LLM_BASE_URL=https://api.cent-ai.dev/v1

# Your key from the Cent AI dashboard (looks like cai_...). Never commit it.
LLM_API_KEY=

# Model used by the vision call (src/vision.ts / scripts/smoke-test.mjs).
# claude-haiku-5.5 chosen after smoke-testing 3 candidates on dev/shot.png:
#   claude-haiku-5.5:  ~10-30s, reliable (4/4 runs), 604 in / ~2000-2100 out tokens, correct & complete output.
#   claude-sonnet-4-6: ~85-90s, more semantic/idiomatic HTML but 7x slower and still hit the token cap - too slow for an in-editor command.
#   claude-fable-5.1:  ~27-30s when it worked, but only 1/4 runs succeeded (503 timeout otherwise) - unreliable despite technically supporting vision.
LLM_MODEL=claude-haiku-5.5
