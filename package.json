{
  "name": "paste-screenshot-css",
  "displayName": "Paste Screenshot as CSS",
  "description": "Paste a clipboard screenshot, get HTML/CSS back at your cursor. macOS only for now.",
  "version": "0.1.0",
  "private": true,
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/vincentag11323/paste-screenshot-css.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/src/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "pasteScreenshotAsCss.run",
        "title": "Paste Screenshot as CSS"
      },
      {
        "command": "pasteScreenshotAsCss.setApiKey",
        "title": "Paste Screenshot as CSS: Set Cent AI API Key"
      },
      {
        "command": "pasteScreenshotAsCss.setOutputFlavor",
        "title": "Paste Screenshot as CSS: Set Output Style"
      },
      {
        "command": "pasteScreenshotAsCss.regenerateMoreDetail",
        "title": "Paste Screenshot as CSS: Regenerate with More Detail"
      }
    ],
    "keybindings": [
      {
        "command": "pasteScreenshotAsCss.run",
        "key": "ctrl+shift+v",
        "mac": "cmd+shift+v",
        "when": "editorTextFocus"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "pretest": "npm run compile",
    "test": "node --test out/test/*.test.js",
    "smoke-test": "node --env-file=.env scripts/smoke-test.mjs",
    "qa": "npm run compile && node --env-file=.env scripts/qaFullFlow.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.6.0"
  }
}
